{
  "name": "workspace",
  "version": "1.0.0",
  "description": "노후 수입 설계 서비스의 초기 기획 및 엔지니어링 문서 저장소입니다.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests && npm run build && npm run test:e2e",
    "test:unit": "python3 -m unittest discover -s tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
